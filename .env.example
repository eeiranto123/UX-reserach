# Anthropic API key (or use `ant auth login`; the SDK picks up the profile automatically)
ANTHROPIC_API_KEY=

# Comma-separated hostnames the persona agents may visit. Subdomains are included.
# Keep this to staging / preview environments only.
ALLOWED_TARGET_HOSTS=staging.example.com

# How many persona sessions run in parallel (each one is a headless browser tab + an agent loop)
MAX_CONCURRENT_SESSIONS=3

# Optional overrides
# UXR_MODEL=claude-opus-5-5
# UXR_AGENT_EFFORT=medium
# UXR_DATA_DIR=./data
